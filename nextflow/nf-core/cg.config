// vim: ft=groovy syntax=nextflow

params {
    config_profile_contact = "Clinical Genomics Umea"
    config_profile_url = "https://github.com/Clinical-Genomics-Umea"
}

process {
    executor = "slurm"
    queue = "clinical"
    scratch = "/tmp"
    maxRetries = 2
    resourceLimits = [
        time: "24.h",
        cpus: 256,
        memory: "2063602.MB"
    ]
}

executor {
    queueSize = 100
    submitRateLimit = "10 sec"
}

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = "/storage/userdata/clinical-genomics/cg_nextflow_apptainer_cache"
    runOptions = "--cleanenv"
}

profiles {
    research {
        params.config_profile_description = "Clinical Genomics Umea nf-core profile for research use"
        process.queue = "research"
    }
}